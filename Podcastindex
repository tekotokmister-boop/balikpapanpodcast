                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 gap-3">
                        <h2 class="font-bold text-slate-900 text-base flex items-center">
                            <i class="fa-solid fa-calendar-check text-indigo-600 mr-2"></i> Daftar Jadwal Podcast & Approval
                        </h2>
                        <div>
                            <select id="filterPodDiv" onchange="renderPodcastTable()" class="text-xs border border-slate-300 rounded-lg px-2.5 py-1.5 bg-slate-50 focus:outline-none">
                                <option value="ALL">Semua Tim</option>
                                <option value="LKP">LKP</option>
                                <option value="LKU">LKU</option>
                                <option value="LKS">LKS</option>
                                <option value="LDM">LDM</option>
                                <option value="LBH">LBH</option>
                                <option value="LKM">LKM</option>
                                <option value="LIT">LIT</option>
                            </select>
                        </div>
                    </div>

                    <div class="overflow-x-auto flex-1">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-100 text-xs font-semibold text-slate-400 uppercase">
                                    <th class="py-3 px-3">Tim & Waktu</th>
                                    <th class="py-3 px-3">Judul & Detail</th>
                                    <th class="py-3 px-3">Status</th>
                                    <th class="py-3 px-3 text-right">Aksi Admin</th>
                                </tr>
                            </thead>
                            <tbody id="podcastTableBody" class="divide-y divide-slate-100 text-sm">
                                <!-- Data rows inserted dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= TAB 2: KONTEN (MEME/CAROUSEL) ================= -->
        <div id="viewContent" class="space-y-6 hidden">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Form Kirim Materi -->
                <div class="lg:col-span-1 bg-white rounded-2xl p-6 border border-slate-200 shadow-xs flex flex-col">
                    <div class="mb-4">
                        <h2 class="font-bold text-slate-900 text-base flex items-center">
                            <i class="fa-solid fa-cloud-arrow-up text-indigo-600 mr-2"></i> Kirim Materi Konten
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Kirim link tulisan/carousel kapanpun bebas tanpa antre.</p>
                    </div>
                    <form id="contentForm" onsubmit="handleContentSubmit(event)" class="space-y-4 flex-1 flex flex-col justify-between">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Divisi Pengirim</label>
                                <select id="contentDivision" required class="w-full rounded-xl border border-slate-300 py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                                    <option value="" disabled selected>Pilih Divisi...</option>
                                    <option value="LKP">LKP</option>
                                    <option value="LKU">LKU</option>
                                    <option value="LKS">LKS</option>
                                    <option value="LDM">LDM</option>
                                    <option value="LBH">LBH</option>
                                    <option value="LKM">LKM</option>
                                    <option value="LIT">LIT</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Jenis Konten</label>
                                <select id="contentType" required class="w-full rounded-xl border border-slate-300 py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                                    <option value="Carousel">Carousel / Infografis</option>
                                    <option value="Meme">Meme / Quotes Kreatif</option>
                                    <option value="Artikel Singkat">Artikel / Opini Singkat</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Judul / Topik Materi</label>
                                <input type="text" id="contentTitle" required placeholder="Contoh: Tips Keamanan Data" class="w-full rounded-xl border border-slate-300 py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Link Tulisan / Google Doc</label>
                                <input type="url" id="contentUrl" required placeholder="https://docs.google.com/..." class="w-full rounded-xl border border-slate-300 py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Catatan Tambahan</label>
                                <textarea id="contentNotes" rows="2" placeholder="Poin penting untuk tim medsos..." class="w-full rounded-xl border border-slate-300 py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
                            </div>
                        </div>
                        <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-sm transition shadow-sm shadow-indigo-100 flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>Kirim Materi Sekarang</span>
                        </button>
                    </form>
                </div>

                <!-- Daftar Materi Masuk -->
                <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200 shadow-xs flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="font-bold text-slate-900 text-base flex items-center">
                            <i class="fa-solid fa-folder-open text-indigo-600 mr-2"></i> Arsip Bahan Meme & Carousel Masuk
                        </h2>
                        <select id="filterContentDiv" onchange="renderContentTable()" class="text-xs border border-slate-300 rounded-lg px-2.5 py-1.5 bg-slate-50 focus:outline-none">
                            <option value="ALL">Semua Tim</option>
                            <option value="LKP">LKP</option>
                            <option value="LKU">LKU</option>
                            <option value="LKS">LKS</option>
                            <option value="LDM">LDM</option>
                            <option value="LBH">LBH</option>
                            <option value="LKM">LKM</option>
                            <option value="LIT">LIT</option>
                        </select>
                    </div>

                    <div class="overflow-x-auto flex-1">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-100 text-xs font-semibold text-slate-400 uppercase">
                                    <th class="py-3 px-3">Tim & Waktu</th>
                                    <th class="py-3 px-3">Jenis & Topik</th>
                                    <th class="py-3 px-3">Link Tulisan</th>
                                    <th class="py-3 px-3 text-right">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="contentTableBody" class="divide-y divide-slate-100 text-sm">
                                <!-- Data rows inserted dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Settings / Firebase Config Modal -->
    <div id="settingsModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl p-6 max-w-lg w-full mx-4 shadow-2xl border border-slate-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-slate-900 text-base flex items-center">
                    <i class="fa-solid fa-database text-indigo-600 mr-2"></i> Konfigurasi Firebase Firestore
                </h3>
                <button onclick="closeSettingsModal()" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <p class="text-xs text-slate-500 mb-4">
                Masukkan objek konfigurasi Firebase Anda agar aplikasi tersambung secara <i>real-time</i> ke database cloud. Jika dikosongkan, aplikasi memakai LocalStorage (Demo).
            </p>
            <div class="space-y-3 mb-6">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Firebase Config JSON</label>
                    <textarea id="firebaseConfigInput" rows="5" placeholder='{
  "apiKey": "AIzaSy...",
  "authDomain": "...",
  "projectId": "...",
  "storageBucket": "...",
  "messagingSenderId": "...",
  "appId": "..."
}' class="w-full rounded-xl border border-slate-300 p-3 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
                </div>
            </div>
            <div class="flex justify-end gap-3">
                <button onclick="closeSettingsModal()" class="px-4 py-2 border border-slate-300 text-slate-700 rounded-xl text-sm font-medium hover:bg-slate-50 transition">Batal</button>
                <button onclick="saveFirebaseConfig()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-medium transition shadow-sm">Simpan Konfigurasi</button>
            </div>
        </div>
    </div>

    <!-- Firebase SDK Imports -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getFirestore, collection, addDoc, getDocs, updateDoc, deleteDoc, doc, onSnapshot, query, orderBy } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        let db = null;
        let isFirebaseActive = false;

        let localPodcasts = JSON.parse(localStorage.getItem('hub_podcasts')) || [
            { id: 'demo1', division: 'LKP', title: 'Ep. 01 - Pengantar Literasi Digital', date: '2026-03-01', time: '14:00', people: 'Host: Rina | Narsum: Prof. Budi', notes: 'Membahas dasar literasi.', status: 'Disetujui', timestamp: '2026-02-20' }
        ];

        let localContents = JSON.parse(localStorage.getItem('hub_contents')) || [
            { id: 'demo1', division: 'LBH', type: 'Carousel', title: 'Hak-hak Dasar Mahasiswa', url: 'https://docs.google.com/document/d/example', notes: 'Infografis 5 slide.', timestamp: '2026-02-21' }
        ];

        window.podcastsData = localPodcasts;
        window.contentsData = localContents;

        // Initialize Firebase from LocalStorage if available
        const savedConfig = localStorage.getItem('hub_firebase_cfg');
        if (savedConfig) {
            try {
                const firebaseConfig = JSON.parse(savedConfig);
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                isFirebaseActive = true;
                document.getElementById('dbStatusBadge').className = "flex items-center px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full text-xs font-medium";
                document.getElementById('dbStatusText').innerText = "Firebase Terhubung (Real-time)";
                setupRealtimeListeners(db);
            } catch (e) {
                console.error("Gagal inisialisasi Firebase:", e);
            }
        }

        function setupRealtimeListeners(database) {
            // Listen Podcasts
            const qPod = query(collection(database, "podcasts"), orderBy("timestamp", "desc"));
            onSnapshot(qPod, (snapshot) => {
                window.podcastsData = [];
                snapshot.forEach((docSnap) => {
                    window.podcastsData.push({ id: docSnap.id, ...docSnap.data() });
                });
                renderPodcastTable();
            }, (error) => { console.error("Error podcast listener:", error); });

            // Listen Contents
            const qCon = query(collection(database, "contents"), orderBy("timestamp", "desc"));
            onSnapshot(qCon, (snapshot) => {
                window.contentsData = [];
                snapshot.forEach((docSnap) => {
                    window.contentsData.push({ id: docSnap.id, ...docSnap.data() });
                });
                renderContentTable();
            }, (error) => { console.error("Error content listener:", error); });
        }

        // --- Global Handlers exposed to window ---
        window.handlePodcastSubmit = async function(e) {
            e.preventDefault();
            const newPod = {
                division: document.getElementById('podDivision').value,
                title: document.getElementById('podTitle').value,
                date: document.getElementById('podDate').value,
                time: document.getElementById('podTime').value,
                people: document.getElementById('podPeople').value,
                notes: document.getElementById('podNotes').value,
                status: 'Pending',
                timestamp: new Date().toISOString()
            };

            if (isFirebaseActive && db) {
                try {
                    await addDoc(collection(db, "podcasts"), newPod);
                    showModal('Berhasil!', 'Request jadwal podcast berhasil dikirim ke database cloud.');
                } catch (err) {
                    showModal('Gagal', 'Terjadi kesalahan saat menyimpan ke Firebase.', 'fa-solid fa-triangle-exclamation text-rose-600');
                }
            } else {
                newPod.id = 'loc_' + Date.now();
                window.podcastsData.unshift(newPod);
                localStorage.setItem('hub_podcasts', JSON.stringify(window.podcastsData));
                renderPodcastTable();
                showModal('Berhasil (Lokal)!', 'Request jadwal disimpan di mode lokal.');
            }
            document.getElementById('podcastForm').reset();
        }

        window.updatePodcastStatus = async function(id, newStatus) {
            if (isFirebaseActive && db && !id.toString().startsWith('loc_')) {
                try {
                    await updateDoc(doc(db, "podcasts", id), { status: newStatus });
                } catch (err) { console.error(err); }
            } else {
                const p = window.podcastsData.find(item => item.id === id);
                if (p) p.status = newStatus;
                localStorage.setItem('hub_podcasts', JSON.stringify(window.podcastsData));
                renderPodcastTable();
            }
        }

        window.deletePodcastItem = async function(id) {
            if (isFirebaseActive && db && !id.toString().startsWith('loc_')) {
                try {
                    await deleteDoc(doc(db, "podcasts", id));
                } catch (err) { console.error(err); }
            } else {
                window.podcastsData = window.podcastsData.filter(item => item.id !== id);
                localStorage.setItem('hub_podcasts', JSON.stringify(window.podcastsData));
                renderPodcastTable();
            }
        }

        window.handleContentSubmit = async function(e) {
            e.preventDefault();
            const newContent = {
                division: document.getElementById('contentDivision').value,
                type: document.getElementById('contentType').value,
                title: document.getElementById('contentTitle').value,
                url: document.getElementById('contentUrl').value,
                notes: document.getElementById('contentNotes').value,
                timestamp: new Date().toISOString()
            };

            if (isFirebaseActive && db) {
                try {
                    await addDoc(collection(db, "contents"), newContent);
                    showModal('Terkirim!', 'Materi konten berhasil dikirim ke database cloud.');
                } catch (err) {
                    showModal('Gagal', 'Terjadi kesalahan.', 'fa-solid fa-triangle-exclamation text-rose-600');
                }
            } else {
                newContent.id = 'loc_' + Date.now();
                window.contentsData.unshift(newContent);
                localStorage.setItem('hub_contents', JSON.stringify(window.contentsData));
                renderContentTable();
                showModal('Terkirim (Lokal)!', 'Materi konten disimpan di mode lokal.');
            }
            document.getElementById('contentForm').reset();
        }

        window.deleteContentItem = async function(id) {
            if (isFirebaseActive && db && !id.toString().startsWith('loc_')) {
                try {
                    await deleteDoc(doc(db, "contents", id));
                } catch (err) { console.error(err); }
            } else {
                window.contentsData = window.contentsData.filter(item => item.id !== id);
                localStorage.setItem('hub_contents', JSON.stringify(window.contentsData));
                renderContentTable();
            }
        }

        window.saveFirebaseConfig = function() {
            const val = document.getElementById('firebaseConfigInput').value;
            if (val.trim()) {
                localStorage.setItem('hub_firebase_cfg', val);
                location.reload();
            }
        }
    </script>

    <!-- Standard UI Helper Script -->
    <script>
        function switchTab(tab) {
            const btnPod = document.getElementById('tabPodcast');
            const btnCon = document.getElementById('tabContent');
            const viewPod = document.getElementById('viewPodcast');
            const viewCon = document.getElementById('viewContent');

            if (tab === 'podcast') {
                btnPod.className = "flex items-center space-x-2 py-2.5 px-5 rounded-xl font-semibold text-sm transition bg-indigo-600 text-white shadow-sm shrink-0";
                btnCon.className = "flex items-center space-x-2 py-2.5 px-5 rounded-xl font-semibold text-sm transition bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 shrink-0";
                viewPod.classList.remove('hidden');
                viewCon.classList.add('hidden');
            } else {
                btnCon.className = "flex items-center space-x-2 py-2.5 px-5 rounded-xl font-semibold text-sm transition bg-indigo-600 text-white shadow-sm shrink-0";
                btnPod.className = "flex items-center space-x-2 py-2.5 px-5 rounded-xl font-semibold text-sm transition bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 shrink-0";
                viewCon.classList.remove('hidden');
                viewPod.classList.add('hidden');
            }
        }

        function showModal(title, message, iconClass = 'fa-solid fa-circle-check text-indigo-600') {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMessage').innerText = message;
            document.getElementById('modalIcon').innerHTML = `<i class="${iconClass}"></i>`;
            document.getElementById('customModal').classList.remove('hidden');
        }
        function closeModal() {
            document.getElementById('customModal').classList.add('hidden');
        }
        function openSettingsModal() {
            const cfg = localStorage.getItem('hub_firebase_cfg') || '';
            document.getElementById('firebaseConfigInput').value = cfg;
            document.getElementById('settingsModal').classList.remove('hidden');
        }
        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.add('hidden');
        }

        function renderPodcastTable() {
            const tbody = document.getElementById('podcastTableBody');
            const filterDiv = document.getElementById('filterPodDiv').value;
            tbody.innerHTML = '';

            const list = window.podcastsData || [];
            const filtered = list.filter(p => filterDiv === 'ALL' || p.division === filterDiv);

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-slate-400 text-xs">Belum ada data jadwal podcast.</td></tr>`;
                return;
            }

            filtered.forEach(p => {
                let badgeColor = 'bg-amber-50 text-amber-700 border-amber-200';
                if (p.status === 'Disetujui') badgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                if (p.status === 'Bentrok / Reschedule') badgeColor = 'bg-rose-50 text-rose-700 border-rose-200';

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/60 transition";
                tr.innerHTML = `
                    <td class="py-3 px-3">
                        <span class="inline-block px-2 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded font-bold text-xs mb-1">${p.division}</span>
                        <div class="text-xs text-slate-500"><i class="fa-regular fa-calendar mr-1"></i>${p.date} • ${p.time}</div>
                    </td>
                    <td class="py-3 px-3">
                        <div class="font-semibold text-slate-900">${escapeHtml(p.title)}</div>
                        <div class="text-xs text-slate-500 mt-0.5"><i class="fa-solid fa-users mr-1"></i>${escapeHtml(p.people)}</div>
                        ${p.notes ? `<div class="text-xs text-slate-400 italic mt-0.5"><i class="fa-solid fa-note-sticky mr-1"></i>${escapeHtml(p.notes)}</div>` : ''}
                    </td>
                    <td class="py-3 px-3">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border ${badgeColor}">
                            ${p.status}
                        </span>
                    </td>
                    <td class="py-3 px-3 text-right space-x-1">
                        <button onclick="updatePodcastStatus('${p.id}', 'Disetujui')" title="Setujui" class="p-1.5 bg-emerald-50 text-emerald-600 hover:bg-emerald-100 rounded-lg transition"><i class="fa-solid fa-check"></i></button>
                        <button onclick="updatePodcastStatus('${p.id}', 'Bentrok / Reschedule')" title="Tandai Bentrok" class="p-1.5 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-lg transition"><i class="fa-solid fa-triangle-exclamation"></i></button>
                        <button onclick="deletePodcastItem('${p.id}')" title="Hapus" class="p-1.5 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-lg transition"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderContentTable() {
            const tbody = document.getElementById('contentTableBody');
            const filterDiv = document.getElementById('filterContentDiv').value;
            tbody.innerHTML = '';

            const list = window.contentsData || [];
            const filtered = list.filter(c => filterDiv === 'ALL' || c.division === filterDiv);

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-slate-400 text-xs">Belum ada bahan konten yang dikirim.</td></tr>`;
                return;
            }

            filtered.forEach(c => {
                let typeColor = 'bg-purple-50 text-purple-700 border-purple-200';
                if (c.type === 'Meme') typeColor = 'bg-sky-50 text-sky-700 border-sky-200';

                const dateStr = c.timestamp ? c.timestamp.split('T')[0] : '';
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/60 transition";
                tr.innerHTML = `
                    <td class="py-3 px-3">
                        <span class="inline-block px-2 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded font-bold text-xs mb-1">${c.division}</span>
                        <div class="text-xs text-slate-400">${dateStr}</div>
                    </td>
                    <td class="py-3 px-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold border ${typeColor} mb-1">${c.type}</span>
                        <div class="font-semibold text-slate-900">${escapeHtml(c.title)}</div>
                        ${c.notes ? `<div class="text-xs text-slate-400 italic mt-0.5">${escapeHtml(c.notes)}</div>` : ''}
                    </td>
                    <td class="py-3 px-3">
                        <a href="${escapeHtml(c.url)}" target="_blank" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 font-medium text-xs bg-indigo-50 px-2.5 py-1.5 rounded-lg border border-indigo-100 transition">
                            <i class="fa-solid fa-external-link mr-1.5"></i> Buka Link Tulisan
                        </a>
                    </td>
                    <td class="py-3 px-3 text-right">
                        <button onclick="deleteContentItem('${c.id}')" class="p-1.5 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-lg transition"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        window.onload = function() {
            renderPodcastTable();
            renderContentTable();
        };
    </script>
</body>
</html>
