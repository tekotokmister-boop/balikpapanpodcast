        <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl border border-slate-100 transform transition-all">
            <div id="modalIcon" class="text-4xl mb-3 text-center"></div>
            <h3 id="modalTitle" class="text-lg font-bold text-slate-900 text-center mb-1">Pemberitahuan</h3>
            <p id="modalMessage" class="text-slate-600 text-sm text-center mb-6"></p>
            <div id="modalActions" class="flex justify-center gap-3">
                <button onclick="closeModal()" class="w-full py-2.5 px-4 bg-indigo-600 text-white rounded-xl font-medium hover:bg-indigo-700 transition shadow-sm">OK</button>
            </div>
        </div>
    </div>

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-md shadow-indigo-100">
                    <i class="fa-solid fa-podcast text-lg"></i>
                </div>
                <div>
                    <h1 class="font-bold text-slate-900 text-lg leading-snug">Podcast & Konten Hub</h1>
                    <p class="text-xs text-slate-500">LKP, LKU, LKS, LDM, LBH, LKM, LIT</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <div id="dbStatusBadge" class="flex items-center px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-xs font-medium">
                    <span class="w-2 h-2 rounded-full bg-amber-500 mr-2 animate-pulse"></span>
                    <span id="dbStatusText">Mode Lokal / Konfigurasi</span>
                </div>
                <button onclick="openSettingsModal()" class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition" title="Konfigurasi Firebase">
                    <i class="fa-solid fa-gear text-lg"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col">
        
        <!-- Tab Navigation -->
        <div class="flex space-x-2 border-b border-slate-200 pb-3 mb-6 overflow-x-auto">
            <button onclick="switchTab('podcast')" id="tabPodcast" class="flex items-center space-x-2 py-2.5 px-5 rounded-xl font-semibold text-sm transition bg-indigo-600 text-white shadow-sm shrink-0">
                <i class="fa-solid fa-calendar-days"></i>
                <span>Jadwal Podcast & Request</span>
            </button>
            <button onclick="switchTab('content')" id="tabContent" class="flex items-center space-x-2 py-2.5 px-5 rounded-xl font-semibold text-sm transition bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 shrink-0">
                <i class="fa-solid fa-photo-film"></i>
                <span>Kirim Materi Konten (Meme/Carousel)</span>
            </button>
        </div>

        <!-- ================= TAB 1: PODCAST ================= -->
        <div id="viewPodcast" class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Form Request Podcast -->
                <div class="lg:col-span-1 bg-white rounded-2xl p-6 border border-slate-200 shadow-xs flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="font-bold text-slate-900 text-base flex items-center">
                            <i class="fa-solid fa-circle-plus text-indigo-600 mr-2"></i> Request Jadwal Podcast
                        </h2>
                    </div>
                    <form id="podcastForm" onsubmit="handlePodcastSubmit(event)" class="space-y-4 flex-1 flex flex-col justify-between">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Divisi / Tim Pengusul</label>
                                <select id="podDivision" required class="w-full rounded-xl border border-slate-300 py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                                    <option value="" disabled selected>Pilih Divisi...</option>
                                    <option value="LKP">LKP</option>
                                    <option value="LKU">LKU</option>
                                    <option value="LKS">LKS</option>
                                    <option value="LDM">LDM</option>
                                    <option value="LBH">LBH</option>
                                    <option value="LKM">LKM</option>
                                    <option value="LIT">LIT</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Judul / Tema Podcast</label>
                                <input type="text" id="podTitle" required placeholder="Contoh: Ep. 12 - Transformasi Digital" class="w-full rounded-xl border border-slate-300 py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Tanggal</label>
                                    <input type="date" id="podDate" required class="w-full rounded-xl border border-slate-300 py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Jam Tayang</label>
                                    <input type="time" id="podTime" required class="w-full rounded-xl border border-slate-300 py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" value="15:00">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Host & Narasumber</label>
                                <input type="text" id="podPeople" required placeholder="Host: Budi | Narsum: Dr. Andi" class="w-full rounded-xl border border-slate-300 py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Catatan / Link Brief (Opsional)</label>
                                <textarea id="podNotes" rows="2" placeholder="Link Google Doc atau catatan..." class="w-full rounded-xl border border-slate-300 py-2 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
