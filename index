<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Podcast & Hub Konten Tim</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome untuk ikon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen">

    <!-- Header / Navigasi Utama -->
    <header class="bg-indigo-700 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 p-2.5 rounded-xl border border-indigo-500 shadow-inner">
                    <i class="fa-solid fa-podcast text-2xl text-amber-300"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight">Hub Podcast & Konten Tim</h1>
                    <p class="text-xs text-indigo-200">Kolaborasi Divisi: LKP, LKU, LKS, LDM, LBH, LKM, LIT</p>
                </div>
            </div>
            <!-- Tab Navigasi -->
            <div class="flex bg-indigo-900/60 p-1 rounded-xl border border-indigo-600">
                <button onclick="switchTab('podcast')" id="tab-podcast" class="px-4 py-2 text-sm font-medium rounded-lg transition-all bg-white text-indigo-900 shadow">
                    <i class="fa-solid fa-calendar-days mr-2"></i>Jadwal Podcast
                </button>
                <button onclick="switchTab('materi')" id="tab-materi" class="px-4 py-2 text-sm font-medium rounded-lg transition-all text-indigo-100 hover:text-white">
                    <i class="fa-solid fa-file-pen mr-2"></i>Kirim Materi (Meme/Carousel)
                </button>
            </div>
        </div>
    </header>

    <!-- Konten Utama -->
    <main class="max-w-7xl mx-auto px-4 py-8">

        <!-- ================= SECTION 1: PODCAST ================= -->
        <section id="section-podcast" class="space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <!-- Form Input Podcast -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-fit">
                    <h2 class="text-lg font-bold text-slate-900 mb-1 flex items-center">
                        <i class="fa-solid fa-circle-plus text-indigo-600 mr-2"></i>Request Jadwal Podcast
                    </h2>
                    <p class="text-xs text-slate-500 mb-5">Usulkan jadwal, tema, host, dan narasumber podcast tim Anda.</p>
                    
                    <form id="form-podcast" onsubmit="submitPodcast(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Divisi / Tim Pengusul</label>
                            <select id="p_divisi" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                <option value="" disabled selected>-- Pilih Tim --</option>
                                <option value="LKP">LKP</option>
                                <option value="LKU">LKU</option>
                                <option value="LKS">LKS</option>
                                <option value="LDM">LDM</option>
                                <option value="LBH">LBH</option>
                                <option value="LKM">LKM</option>
                                <option value="LIT">LIT</option>
                            </select>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Tanggal Request</label>
                                <input type="date" id="p_tanggal" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Jam / Sesi</label>
                                <input type="time" id="p_jam" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Judul / Topik Utama</label>
                            <input type="text" id="p_judul" placeholder="Contoh: Diskusi Regulasi Baru..." required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Host Bertugas</label>
                                <input type="text" id="p_host" placeholder="Nama Host" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Narasumber / Guest</label>
                                <input type="text" id="p_narsum" placeholder="Nama Narasumber" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Catatan / Link Pendukung</label>
                            <textarea id="p_catatan" rows="2" placeholder="Link Google Drive, skrip, dll." class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
                        </div>

                        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-xl transition text-sm shadow-sm">
                            <i class="fa-solid fa-paper-plane mr-2"></i>Kirim Request Jadwal
                        </button>
                    </form>
                </div>

                <!-- Tabel Rekapitulasi Podcast -->
                <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">Daftar Jadwal & Status Podcast</h2>
                            <p class="text-xs text-slate-500">Pantau jadwal yang sudah diajukan, status persetujuan, dan penyesuaian waktu.</p>
                        </div>
                        <div class="flex gap-2">
                            <select id="filter-divisi" onchange="renderPodcast()" class="px-3 py-1.5 border border-slate-300 rounded-lg text-xs bg-slate-50">
                                <option value="ALL">Semua Tim</option>
                                <option value="LKP">LKP</option>
                                <option value="LKU">LKU</option>
                                <option value="LKS">LKS</option>
                                <option value="LDM">LDM</option>
                                <option value="LBH">LBH</option>
                                <option value="LKM">LKM</option>
                                <option value="LIT">LIT</option>
                            </select>
                        </div>
                    </div>

                    <div class="overflow-x-auto flex-grow">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 text-slate-400 text-xs uppercase tracking-wider">
                                    <th class="py-3 px-3">Tim & Jadwal</th>
                                    <th class="py-3 px-3">Topik / Tema</th>
                                    <th class="py-3 px-3">Host & Narasumber</th>
                                    <th class="py-3 px-3">Status</th>
                                    <th class="py-3 px-3 text-right">Aksi Admin</th>
                                </tr>
                            </thead>
                            <tbody id="table-podcast-body" class="divide-y divide-slate-100 text-sm">
                                <!-- Data dimuat dinamis lewat JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </section>

        <!-- ================= SECTION 2: MATERI KONTEN (MEME/CAROUSEL) ================= -->
        <section id="section-materi" class="space-y-8 hidden">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <!-- Form Kirim Materi -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-fit">
                    <h2 class="text-lg font-bold text-slate-900 mb-1 flex items-center">
                        <i class="fa-solid fa-cloud-arrow-up text-amber-500 mr-2"></i>Kirim Bahan Tulisan / Link
                    </h2>
                    <p class="text-xs text-slate-500 mb-5">Kirimkan draf materi tulisan kapan pun untuk diolah menjadi Meme atau Carousel.</p>
                    
                    <form id="form-materi" onsubmit="submitMateri(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Divisi Pengirim</label>
                            <select id="m_divisi" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                                <option value="" disabled selected>-- Pilih Tim --</option>
                                <option value="LKP">LKP</option>
                                <option value="LKU">LKU</option>
                                <option value="LKS">LKS</option>
                                <option value="LDM">LDM</option>
                                <option value="LBH">LBH</option>
                                <option value="LKM">LKM</option>
                                <option value="LIT">LIT</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Jenis Konten Target</label>
                            <select id="m_jenis" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                                <option value="Carousel">Carousel / Infografis</option>
                                <option value="Meme">Meme / Konten Visual Ringan</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Judul / Topik Tulisan</label>
                            <input type="text" id="m_judul" placeholder="Contoh: Poin Penting Aturan..." required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Link Tulisan / Google Doc</label>
                            <input type="url" id="m_link" placeholder="https://docs.google.com/..." required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">Catatan Tambahan</label>
                            <textarea id="m_catatan" rows="3" placeholder="Pesan untuk tim kreatif..." class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></textarea>
                        </div>

                        <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-medium py-2.5 rounded-xl transition text-sm shadow-sm">
                            <i class="fa-solid fa-paper-plane mr-2"></i>Kirim Materi Konten
                        </button>
                    </form>
                </div>

                <!-- Daftar Materi Masuk -->
                <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col">
                    <h2 class="text-lg font-bold text-slate-900 mb-1">Arsip Materi Konten Masuk</h2>
                    <p class="text-xs text-slate-500 mb-6">Daftar link tulisan dan draf materi dari seluruh divisi yang siap diolah.</p>

                    <div class="overflow-x-auto flex-grow">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 text-slate-400 text-xs uppercase tracking-wider">
                                    <th class="py-3 px-3">Divisi & Waktu</th>
                                    <th class="py-3 px-3">Target</th>
                                    <th class="py-3 px-3">Judul & Catatan</th>
                                    <th class="py-3 px-3 text-right">Aksi Link</th>
                                </tr>
                            </thead>
                            <tbody id="table-materi-body" class="divide-y divide-slate-100 text-sm">
                                <!-- Data dimuat dinamis lewat JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </section>

    </main>

    <!-- Firebase SDK Scripts -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getFirestore, collection, addDoc, getDocs, doc, updateDoc, deleteDoc, onSnapshot, query, orderBy } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        // Konfigurasi Firebase Anda
        const firebaseConfig = {
            apiKey: "AIzaSyDUQtMUibWA1atiFRnfh3FWIzLAd6f6C3M",
            authDomain: "balikpapanpodcast-e63f2.firebaseapp.com",
            databaseURL: "https://balikpapanpodcast-e63f2-default-rtdb.firebaseio.com",
            projectId: "balikpapanpodcast-e63f2",
            storageBucket: "balikpapanpodcast-e63f2.firebasestorage.app",
            messagingSenderId: "316601698941",
            appId: "1:316601698941:web:860e854cdde37c678f7f14"
        };

        // Inisialisasi Firebase
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        // Global functions untuk diakses HTML window
        window.db = db;
        window.collection = collection;
        window.addDoc = addDoc;
        window.getDocs = getDocs;
        window.doc = doc;
        window.updateDoc = updateDoc;
        window.deleteDoc = deleteDoc;
        window.onSnapshot = onSnapshot;
        window.query = query;
        window.orderBy = orderBy;

        // Load data real-time saat halaman siap
        initRealtimeListeners();
    </script>

    <!-- Main Application Logic -->
    <script>
        // Tab Switcher
        function switchTab(tab) {
            const secPodcast = document.getElementById('section-podcast');
            const secMateri = document.getElementById('section-materi');
            const tabPodcast = document.getElementById('tab-podcast');
            const tabMateri = document.getElementById('tab-materi');

            if (tab === 'podcast') {
                secPodcast.classList.remove('hidden');
                secMateri.classList.add('hidden');
                tabPodcast.className = "px-4 py-2 text-sm font-medium rounded-lg transition-all bg-white text-indigo-900 shadow";
                tabMateri.className = "px-4 py-2 text-sm font-medium rounded-lg transition-all text-indigo-100 hover:text-white";
            } else {
                secPodcast.classList.add('hidden');
                secMateri.classList.remove('hidden');
                tabMateri.className = "px-4 py-2 text-sm font-medium rounded-lg transition-all bg-white text-indigo-900 shadow";
                tabPodcast.className = "px-4 py-2 text-sm font-medium rounded-lg transition-all text-indigo-100 hover:text-white";
            }
        }

        // --- MANAJEMEN PODCAST ---
        async function submitPodcast(e) {
            e.preventDefault();
            const data = {
                divisi: document.getElementById('p_divisi').value,
                tanggal: document.getElementById('p_tanggal').value,
                jam: document.getElementById('p_jam').value,
                judul: document.getElementById('p_judul').value,
                host: document.getElementById('p_host').value,
                narsum: document.getElementById('p_narsum').value,
                catatan: document.getElementById('p_catatan').value,
                status: 'Menunggu Persetujuan (Pending)',
                createdAt: new Date().toISOString()
            };

            try {
                await window.addDoc(window.collection(window.db, "podcast_schedules"), data);
                alert("Berhasil! Request jadwal podcast telah dikirim.");
                document.getElementById('form-podcast').reset();
            } catch (error) {
                console.error("Error adding document: ", error);
                alert("Gagal mengirim data. Pastikan koneksi dan Firestore aktif.");
            }
        }

        async function updateStatus(id, newStatus) {
            try {
                const docRef = window.doc(window.db, "podcast_schedules", id);
                await window.updateDoc(docRef, { status: newStatus });
            } catch (error) {
                console.error("Error updating status: ", error);
            }
        }

        async function deletePodcast(id) {
            if (confirm("Hapus jadwal ini?")) {
                try {
                    await window.deleteDoc(window.doc(window.db, "podcast_schedules", id));
                } catch (error) {
                    console.error("Error deleting: ", error);
                }
            }
        }

        // --- MANAJEMEN MATERI KONTEN ---
        async function submitMateri(e) {
            e.preventDefault();
            const data = {
                divisi: document.getElementById('m_divisi').value,
                jenis: document.getElementById('m_jenis').value,
                judul: document.getElementById('m_judul').value,
                link: document.getElementById('m_link').value,
                catatan: document.getElementById('m_catatan').value,
                createdAt: new Date().toISOString()
            };

            try {
                await window.addDoc(window.collection(window.db, "content_materials"), data);
                alert("Berhasil! Bahan materi konten berhasil dikirim.");
                document.getElementById('form-materi').reset();
            } catch (error) {
                console.error("Error addingateri: ", error);
                alert("Gagal mengirim materi.");
            }
        }

        async function deleteMateri(id) {
            if (confirm("Hapus arsip materi ini?")) {
                try {
                    await window.deleteDoc(window.doc(window.db, "content_materials", id));
                } catch (error) {
                    console.error("Error deleting materi: ", error);
                }
            }
        }

        // --- REALTIME SYNC (FIREBASE LISTENERS) ---
        let globalPodcastData = [];

        function initRealtimeListeners() {
            // Listener Podcast
            const qPodcast = window.query(window.collection(window.db, "podcast_schedules"), window.orderBy("createdAt", "desc"));
            window.onSnapshot(qPodcast, (snapshot) => {
                globalPodcastData = [];
                snapshot.forEach((doc) => {
                    globalPodcastData.push({ id: doc.id, ...doc.data() });
                });
                renderPodcast();
            });

            // Listener Materi
            const qMateri = window.query(window.collection(window.db, "content_materials"), window.orderBy("createdAt", "desc"));
            window.onSnapshot(qMateri, (snapshot) => {
                let html = "";
                snapshot.forEach((doc) => {
                    const d = doc.data();
                    const badgeColor = d.jenis === 'Carousel' ? 'bg-sky-100 text-sky-700' : 'bg-pink-100 text-pink-700';
                    html += `
                        <tr class="hover:bg-slate-50 transition">
                            <td class="py-3 px-3">
                                <span class="font-bold text-slate-700">${d.divisi}</span>
                                <div class="text-xs text-slate-400">${new Date(d.createdAt).toLocaleDateString('id-ID')}</div>
                            </td>
                            <td class="py-3 px-3">
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${badgeColor}">${d.jenis}</span>
                            </td>
                            <td class="py-3 px-3">
                                <div class="font-semibold text-slate-800">${d.judul}</div>
                                <div class="text-xs text-slate-500">${d.catatan || '-'}</div>
                            </td>
                            <td class="py-3 px-3 text-right space-x-2">
                                <a href="${d.link}" target="_blank" class="inline-flex items-center px-3 py-1 bg-indigo-50 text-indigo-600 hover:bg-indigo-100 rounded-lg text-xs font-medium transition">
                                    <i class="fa-solid fa-link mr-1"></i> Buka Link
                                </a>
                                <button onclick="deleteMateri('${doc.id}')" class="text-slate-400 hover:text-rose-600 text-xs p-1">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
                document.getElementById('table-materi-body').innerHTML = html || `<tr><td colspan="4" class="text-center py-6 text-slate-400">Belum ada materi konten yang dikirim.</td></tr>`;
            });
        }

        function renderPodcast() {
            const filter = document.getElementById('filter-divisi').value;
            const filtered = filter === 'ALL' ? globalPodcastData : globalPodcastData.filter(item => item.divisi === filter);

            let html = "";
            filtered.forEach(d => {
                let badgeStatus = "bg-amber-100 text-amber-800 border-amber-200";
                if (d.status.includes("Disetujui")) badgeStatus = "bg-emerald-100 text-emerald-800 border-emerald-200";
                if (d.status.includes("Reschedule")) badgeStatus = "bg-rose-100 text-rose-800 border-rose-200";

                html += `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-3 px-3">
                            <div class="font-bold text-slate-700 flex items-center">
                                <span class="bg-slate-200 text-slate-700 text-xs px-2 py-0.5 rounded mr-1.5">${d.divisi}</span>
                            </div>
                            <div class="text-xs text-slate-500 mt-1"><i class="fa-regular fa-calendar mr-1"></i>${d.tanggal} (${d.jam})</div>
                        </td>
                        <td class="py-3 px-3">
                            <div class="font-semibold text-slate-800">${d.judul}</div>
                            <div class="text-xs text-slate-400">${d.catatan || ''}</div>
                        </td>
                        <td class="py-3 px-3 text-xs text-slate-600">
                            <div><strong>Host:</strong> ${d.host}</div>
                            <div><strong>Narsum:</strong> ${d.narsum}</div>
                        </td>
                        <td class="py-3 px-3">
                            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold border ${badgeStatus}">${d.status}</span>
                        </td>
                        <td class="py-3 px-3 text-right space-x-1">
                            <button onclick="updateStatus('${d.id}', 'Disetujui (Approved)')" title="Setujui" class="bg-emerald-50 text-emerald-600 hover:bg-emerald-100 p-1.5 rounded-lg text-xs">
                                <i class="fa-solid fa-check"></i>
                            </button>
                            <button onclick="updateStatus('${d.id}', 'Perlu Reschedule / Bentrok')" title="Reschedule" class="bg-amber-50 text-amber-600 hover:bg-amber-100 p-1.5 rounded-lg text-xs">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </button>
                            <button onclick="deletePodcast('${d.id}')" title="Hapus" class="bg-rose-50 text-rose-600 hover:bg-rose-100 p-1.5 rounded-lg text-xs">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });
            document.getElementById('table-podcast-body').innerHTML = html || `<tr><td colspan="5" class="text-center py-6 text-slate-400">Belum ada jadwal podcast yang diajukan.</td></tr>`;
        }
    </script>
</body>
</html>
